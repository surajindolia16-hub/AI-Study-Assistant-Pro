
import os
import json
import math
import sys
import time
from collections import Counter

# --- PROFESSIONAL AI BRIDGE SETUP ---
try:
    import google.generativeai as genai
    # Professional comment: Configuring Google AI Studio API for enhanced semantic synthesis
    genai.configure(api_key="YOUR_GEMINI_API_KEY") 
    MODEL = genai.GenerativeModel('gemini-1.5-flash')
    AI_ENABLED = True
except ImportError:
    AI_ENABLED = False

class MobileAIStudyEngine:
    def __init__(self, database_path="mobile_knowledge_matrix.json"):
        self.database_path = database_path
        self.notes = self._load_database()

    def _load_database(self):
        if os.path.exists(self.database_path):
            with open(self.database_path, "r", encoding="utf-8") as f:
                return json.load(f)
        return []

    # --- CORE MATH ENGINE (TE R A LOGIC) ---
    def _compute_cosine_similarity(self, query):
        """
        [Math Layer]: Calculating semantic distance using TF-IDF and Cosine Similarity.
        This ensures privacy by processing data locally before AI intervention.
        """
        documents = [doc.lower().split() for doc in self.notes]
        query_words = query.lower().split()
        if not documents or not query_words: return None, 0.0

        all_words = set(word for doc in documents for word in doc)
        all_words.update(query_words)
        
        # TF-IDF Calculation Logic
        num_docs = len(documents)
        df_dict = Counter(word for doc in documents for word in set(doc))
        
        # Helper to get vector
        def get_vec(words):
            tf = Counter(words)
            vec = {}
            for w in set(words):
                idf = math.log((1 + num_docs) / (1 + df_dict[w])) + 1
                vec[w] = (tf[w] / len(words)) * idf
            return vec

        query_vec = get_vec(query_words)
        best_idx, max_sim = -1, 0.0

        for idx, doc in enumerate(documents):
            doc_vec = get_vec(doc)
            dot = sum(query_vec[w] * doc_vec.get(w, 0) for w in query_vec)
            norm_q = math.sqrt(sum(v**2 for v in query_vec.values()))
            norm_d = math.sqrt(sum(v**2 for v in doc_vec.values()))
            
            if norm_q * norm_d != 0:
                sim = dot / (norm_q * norm_d)
                if sim > max_sim:
                    max_sim, best_idx = sim, idx
        
        return (self.notes[best_idx], max_sim) if max_sim > 0.05 else (None, 0.0)

    # --- THE PROFESSIONAL AI INTEGRATION ---
    def get_ai_synthesis(self, query, context):
        """
        [AI Layer]: Context-aware response generation using Google Gemini.
        Only triggers if local engine confidence is low.
        """
        if not AI_ENABLED: return "[!] AI Module Not Initialized."
        try:
            prompt = f"Context: {context}\nQuery: {query}\nProvide a concise, academic summary."
            return MODEL.generate_content(prompt).text
        except Exception as e:
            return f"[!] AI Synthesis Error: {str(e)}"

    def query_semantic_engine(self, query):
        start = time.perf_counter()
        match, confidence = self._compute_cosine_similarity(query)
        delta = (time.perf_counter() - start) * 1000

        print(f"\n[🔍 Engine Status]: Vector scan completed in {delta:.4f}ms.")
        
        if match:
            print(f"📖 [Local Context Match] ({confidence:.2%}): {match}")
        else:
            print("[⚠️] Low confidence. Escalating to Generative AI Cloud...")
            print(f"🤖 [Gemini AI Insight]: {self.get_ai_synthesis(query, 'General Knowledge')}")

